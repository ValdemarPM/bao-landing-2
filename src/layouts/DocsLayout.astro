---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DocsSidebar from '../components/docs/DocsSidebar.astro';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Banners All Over - Documentation" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Banners All Over</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>

  <body class="min-h-screen bg-gray-50 selection-bao">
    <Header />

    <div class="flex min-h-[calc(100vh-200px)]">
      <!-- Sidebar -->
      <DocsSidebar />

      <!-- Main Content -->
      <main class="flex-1 w-full">
        <div class="max-w-4xl mx-auto px-6 py-12 lg:px-8">
          <slot />
        </div>
      </main>
    </div>

    <Footer />
  </body>
</html>

<style>
  /* Documentation specific styles */
  :global(.docs-content) {
    @apply text-gray-700 leading-relaxed;
  }

  :global(.docs-content h1) {
    @apply text-4xl font-bold text-gray-900 mb-6 pb-3 border-b-2 border-bao-blue-400;
  }

  :global(.docs-content h2) {
    @apply text-3xl font-bold text-gray-900 mt-12 mb-4 pb-2 border-b border-gray-200;
  }

  :global(.docs-content h3) {
    @apply text-2xl font-semibold text-gray-800 mt-8 mb-3;
  }

  :global(.docs-content h4) {
    @apply text-xl font-semibold text-gray-800 mt-6 mb-2;
  }

  :global(.docs-content p) {
    @apply mb-4 text-base;
  }

  :global(.docs-content ul),
  :global(.docs-content ol) {
    @apply mb-4 ml-6 space-y-2;
  }

  :global(.docs-content ul) {
    @apply list-disc;
  }

  :global(.docs-content ol) {
    @apply list-decimal;
  }

  :global(.docs-content li) {
    @apply text-base;
  }

  :global(.docs-content strong) {
    @apply font-semibold text-gray-900;
  }

  :global(.docs-content em) {
    @apply italic text-gray-600;
  }

  :global(.docs-content hr) {
    @apply my-8 border-gray-200;
  }

  :global(.docs-content code) {
    @apply bg-gray-100 px-2 py-1 rounded text-sm font-mono text-bao-purple-400;
  }

  /* Special callout boxes */
  :global(.docs-tip) {
    @apply bg-green-50 border-l-4 border-green-400 p-4 my-6 rounded-r;
  }

  :global(.docs-note) {
    @apply bg-yellow-50 border-l-4 border-yellow-400 p-4 my-6 rounded-r;
  }

  :global(.docs-info) {
    @apply bg-blue-50 border-l-4 border-bao-blue-400 p-4 my-6 rounded-r;
  }
</style>
