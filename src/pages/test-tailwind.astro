---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tailwind Test - BAO</title>
</head>
<body class="min-h-screen bg-gray-50 p-8">
    <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold mb-8 text-center">Tailwind CSS Test Page</h1>
        
        <!-- Test BAO Colors that exist -->
        <section class="mb-8">
            <h2 class="text-2xl font-bold mb-4">BAO Brand Colors - All Shades</h2>
            
            <!-- Blue shades -->
            <div class="mb-4">
                <h3 class="font-bold mb-2">Blue Shades:</h3>
                <div class="grid grid-cols-5 gap-2">
                    <div class="bg-bao-blue-50 text-gray-900 p-2 rounded text-center">50</div>
                    <div class="bg-bao-blue-100 text-gray-900 p-2 rounded text-center">100</div>
                    <div class="bg-bao-blue-200 text-gray-900 p-2 rounded text-center">200</div>
                    <div class="bg-bao-blue-300 text-white p-2 rounded text-center">300</div>
                    <div class="bg-bao-blue-400 text-white p-2 rounded text-center">400</div>
                    <div class="bg-bao-blue-500 text-white p-2 rounded text-center">500</div>
                    <div class="bg-bao-blue-600 text-white p-2 rounded text-center">600</div>
                    <div class="bg-bao-blue-700 text-white p-2 rounded text-center">700</div>
                    <div class="bg-bao-blue-800 text-white p-2 rounded text-center">800</div>
                    <div class="bg-bao-blue-900 text-white p-2 rounded text-center">900</div>
                </div>
            </div>
            
            <!-- Purple shades -->
            <div class="mb-4">
                <h3 class="font-bold mb-2">Purple Shades:</h3>
                <div class="grid grid-cols-5 gap-2">
                    <div class="bg-bao-purple-50 text-gray-900 p-2 rounded text-center">50</div>
                    <div class="bg-bao-purple-100 text-gray-900 p-2 rounded text-center">100</div>
                    <div class="bg-bao-purple-200 text-gray-900 p-2 rounded text-center">200</div>
                    <div class="bg-bao-purple-300 text-white p-2 rounded text-center">300</div>
                    <div class="bg-bao-purple-400 text-white p-2 rounded text-center">400</div>
                    <div class="bg-bao-purple-500 text-white p-2 rounded text-center">500</div>
                    <div class="bg-bao-purple-600 text-white p-2 rounded text-center">600</div>
                    <div class="bg-bao-purple-700 text-white p-2 rounded text-center">700</div>
                    <div class="bg-bao-purple-800 text-white p-2 rounded text-center">800</div>
                    <div class="bg-bao-purple-900 text-white p-2 rounded text-center">900</div>
                </div>
            </div>
            
            <!-- Red shades -->
            <div class="mb-4">
                <h3 class="font-bold mb-2">Red Shades:</h3>
                <div class="grid grid-cols-5 gap-2">
                    <div class="bg-bao-red-50 text-gray-900 p-2 rounded text-center">50</div>
                    <div class="bg-bao-red-100 text-gray-900 p-2 rounded text-center">100</div>
                    <div class="bg-bao-red-200 text-gray-900 p-2 rounded text-center">200</div>
                    <div class="bg-bao-red-300 text-white p-2 rounded text-center">300</div>
                    <div class="bg-bao-red-400 text-white p-2 rounded text-center">400</div>
                    <div class="bg-bao-red-500 text-white p-2 rounded text-center">500</div>
                    <div class="bg-bao-red-600 text-white p-2 rounded text-center">600</div>
                    <div class="bg-bao-red-700 text-white p-2 rounded text-center">700</div>
                    <div class="bg-bao-red-800 text-white p-2 rounded text-center">800</div>
                    <div class="bg-bao-red-900 text-white p-2 rounded text-center">900</div>
                </div>
            </div>
            
            <!-- Gray shades -->
            <div class="mb-4">
                <h3 class="font-bold mb-2">Gray Shades:</h3>
                <div class="grid grid-cols-5 gap-2">
                    <div class="bg-bao-gray-50 text-gray-900 p-2 rounded text-center">50</div>
                    <div class="bg-bao-gray-100 text-gray-900 p-2 rounded text-center">100</div>
                    <div class="bg-bao-gray-200 text-gray-900 p-2 rounded text-center">200</div>
                    <div class="bg-bao-gray-300 text-white p-2 rounded text-center">300</div>
                    <div class="bg-bao-gray-400 text-white p-2 rounded text-center">400</div>
                    <div class="bg-bao-gray-500 text-white p-2 rounded text-center">500</div>
                    <div class="bg-bao-gray-600 text-white p-2 rounded text-center">600</div>
                    <div class="bg-bao-gray-700 text-white p-2 rounded text-center">700</div>
                    <div class="bg-bao-gray-800 text-white p-2 rounded text-center">800</div>
                    <div class="bg-bao-gray-900 text-white p-2 rounded text-center">900</div>
                </div>
            </div>
        </section>
        
        <!-- Test Text Colors -->
        <section class="mb-8">
            <h2 class="text-2xl font-bold mb-4">Text Colors</h2>
            <p class="text-bao-blue-400 font-semibold">This text is bao-blue-400</p>
            <p class="text-bao-purple-300 font-semibold">This text is bao-purple-300</p>
            <p class="text-bao-red-300 font-semibold">This text is bao-red-300</p>
            <p class="text-bao-gray-500 font-semibold">This text is bao-gray-500</p>
        </section>
        
        <!-- Test Gradient -->
        <section class="mb-8">
            <h2 class="text-2xl font-bold mb-4">Gradient Test</h2>
            <div class="h-20 bg-gradient-to-r from-bao-blue-400 via-bao-purple-300 to-bao-red-300 rounded"></div>
        </section>
        
        <!-- Test Custom Classes -->
        <section class="mb-8">
            <h2 class="text-2xl font-bold mb-4">Custom Component Classes</h2>
            
            <!-- Primary Gradient Buttons -->
            <h3 class="text-lg font-bold mb-3">BAO Gradient Buttons</h3>
            <div class="flex flex-wrap gap-4 mb-6">
                <button class="btn btn-primary">Install Now - It's Free!</button>
                <button class="btn btn-gradient">Animated Gradient</button>
                <button class="btn btn-primary px-8 py-4 text-lg">Large Button</button>
                <button class="btn btn-primary px-4 py-2 text-sm">Small Button</button>
            </div>
            
            <!-- Button variations with Tailwind utilities -->
            <h3 class="text-lg font-bold mb-3">Gradient Button Variations</h3>
            <div class="flex flex-wrap gap-4 mb-6">
                <!-- Using Tailwind gradient utilities -->
                <button class="px-6 py-3 font-medium text-white rounded-full bg-gradient-to-r from-bao-blue-400 via-bao-purple-300 to-bao-red-300 hover:shadow-lg transition-all hover:-translate-y-1">
                    Tailwind Gradient
                </button>
                
                <!-- Outline gradient button -->
                <button class="relative px-6 py-3 font-medium rounded-full bg-gradient-to-r from-bao-blue-400 via-bao-purple-300 to-bao-red-300 p-[2px]">
                    <span class="flex items-center justify-center bg-white text-transparent bg-clip-text bg-gradient-to-r from-bao-blue-400 via-bao-purple-300 to-bao-red-300 rounded-full px-6 py-2.5">
                        Gradient Outline
                    </span>
                </button>
                
                <!-- Text gradient button -->
                <button class="px-6 py-3 font-bold text-transparent bg-clip-text bg-gradient-to-r from-bao-blue-400 via-bao-purple-300 to-bao-red-300 border-2 border-gray-200 rounded-full hover:border-bao-purple-300 transition-colors">
                    Text Gradient
                </button>
            </div>
            
            <!-- Other button styles -->
            <h3 class="text-lg font-bold mb-3">Other Button Styles</h3>
            <div class="flex gap-4 mb-4">
                <button class="btn btn-secondary">Secondary Button</button>
                <button class="btn btn-danger">Danger Button</button>
            </div>
            
            <div class="card">
                <h3 class="font-bold mb-2">This is a card component</h3>
                <p>It uses the custom card class defined in global.css</p>
            </div>
        </section>
        
        <p class="text-green-600 font-bold">✅ If you see colored boxes and text above, Tailwind is working correctly!</p>
    </div>
</body>
</html>
