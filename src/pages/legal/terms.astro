      <!-- Warranties and Disclaimers -->
      <section class="mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">10. Warranties and Disclaimers</h2>

        <h3 class="text-xl font-semibold text-gray-800 mb-3">10.1 AS-IS Provision</h3>
        <p class="text-gray-700 mb-4">
