---
// Support/CTA Component
---

<section id="support" class="section">
  <div class="container-bao">
    <h2 class="text-4xl font-bold text-center mb-12">Support</h2>
    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <!-- Learn More Card -->
      <div class="card-bao text-center flex flex-col h-full">
        <h3 class="text-2xl font-bold mb-4">Learn more</h3>
        <p class="text-lg mb-6 opacity-80 flex-grow">
          See the documention to get the most out of Banners All Over
        </p>
        <div>
          <a href="/docs" class="btn bg-gradient-to-r from-bao-purple-400 to-bao-red-400 hover:opacity-90">
            Go to documentation
          </a>
        </div>
      </div>

      <!-- Need Help Card -->
      <div class="card-bao text-center flex flex-col h-full">
        <h3 class="text-2xl font-bold mb-4">Need help?</h3>
        <p class="text-lg mb-6 opacity-80 flex-grow">Get in touch with us, we're here to help!</p>
        <div>
          <button class="btn bg-gradient-to-r from-bao-blue-400 to-bao-purple-400 hover:opacity-90">
            Get in touch!
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
