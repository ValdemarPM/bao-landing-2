<section id="pricing" class="section bg-gradient-to-b from-white to-gray-50">
  <div class="container-bao">
    <h2 class="text-4xl font-bold text-center mb-4">Simple, transparent pricing</h2>
    <p class="text-xl text-gray-600 text-center mb-8">Choose the plan that fits your needs</p>

    <!-- Pricing Toggle -->
    <div class="flex justify-center items-center gap-4 mb-12">
      <span class="text-lg font-medium" id="monthly-label">Monthly</span>
      <button
        id="pricing-toggle"
        class="relative inline-flex h-8 w-16 items-center rounded-full bg-blue-500 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
        role="switch"
        aria-checked="true"
        aria-labelledby="yearly-label"
      >
        <span
          class="inline-block h-6 w-6 transform rounded-full bg-white shadow-lg transition-transform translate-x-9"
          id="toggle-indicator"
        ></span>
      </button>
      <span class="text-lg font-medium flex items-center gap-2" id="yearly-label">
        Yearly
        <span class="text-sm bg-green-100 text-green-800 px-2 py-1 rounded-full font-semibold">Save 25%</span>
