---
// Hero Component
---

<section class="section relative overflow-hidden">
  <div class="container-bao">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-5xl lg:text-6xl font-bold mb-6">
        Enhance your Shopify store with
        <span class="text-gradient">stunning banners</span>
      </h1>
      <p class="text-xl text-gray-600 mb-8">
        Banners All Over, the best Shopify App for creating professional banners for your store
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://apps.shopify.com/banners-all-over"
          target="_blank"
          rel="noopener noreferrer"
          class="btn font-bold btn-primary hover-lift"
        >
          Get Started Free
        </a>
        <a
          href="#features"
          class="btn text-transparent bg-clip-text bg-gradient-to-r from-bao-blue-400 via-bao-purple-300 to-bao-red-300 border-2 border-gray-300 hover:border-bao-purple-300"
        >
          Explore Features
        </a>
      </div>
    </div>
  </div>
</section>
