---
// Promo Banner Component
---

<section
  class="section bg-gradient-to-r from-bao-blue-400 via-bao-purple-300 to-bao-red-300 text-white"
>
  <div class="container-bao text-center">
    <h2 class="text-4xl font-bold mb-4">Ready to boost your Shopify store?</h2>
    <div class="flex justify-center mb-6">
      <img src={`${import.meta.env.BASE_URL}/shopify_logomark.svg`} alt="Shopify" class="h-16 w-16" />
    </div>
    <p class="text-xl mb-8 opacity-90">Join thousands of merchants using Banners All Over</p>
    <a href="https://apps.shopify.com/banners-all-over" target="_blank" rel="noopener noreferrer" class="btn bg-white hover:bg-gray-100 shadow-bao-lg">
      <span
        class="bg-gradient-to-r from-bao-blue-400 via-bao-purple-400 to-bao-red-400 bg-clip-text text-transparent font-bold"
      >
        Install Now - It's Free!
      </span>
    </a>
  </div>
</section>
