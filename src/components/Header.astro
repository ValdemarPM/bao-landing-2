---
// Header component for Banners All Over
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100">
  <!-- Top announcement bar -->
  <div
    class="bg-gradient-to-r from-bao-blue-400 via-bao-purple-300 to-bao-red-300 text-white text-center py-2 px-4"
  >
    <p class="text-sm font-medium">Start improving your Shopify store for FREE today!</p>
  </div>

  <!-- Main navigation -->
  <nav class="container-bao">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center group">
        <img
          src="/BAO_logo.svg"
          alt="Banners All Over"
          class="h-10 w-auto transform group-hover:scale-110 transition-transform duration-300"
        />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        <a
          href="#features"
          class="nav-link group relative px-3 py-2 text-gray-600 hover:text-bao-blue-400 font-medium transition-all duration-300 hover:scale-105"
        >
          <span class="relative z-10">Features</span>
          <span
            class="absolute bottom-0 left-0 w-full h-0.5 bg-bao-blue-400 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center"
          ></span>
          <span
            class="absolute inset-0 bg-bao-blue-400/5 rounded-lg transform scale-0 group-hover:scale-100 transition-transform duration-300"
          ></span>
        </a>
        <a
          href="#how-it-works"
          class="nav-link group relative px-3 py-2 text-gray-600 hover:text-bao-purple-300 font-medium transition-all duration-300 hover:scale-105"
        >
          <span class="relative z-10">How it works</span>
          <span
            class="absolute bottom-0 left-0 w-full h-0.5 bg-bao-purple-300 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center"
          ></span>
          <span
            class="absolute inset-0 bg-bao-purple-300/5 rounded-lg transform scale-0 group-hover:scale-100 transition-transform duration-300"
          ></span>
        </a>
        <a
          href="#pricing"
          class="nav-link group relative px-3 py-2 text-gray-600 hover:text-bao-blue-400 font-medium transition-all duration-300 hover:scale-105"
        >
          <span class="relative z-10">Pricing</span>
          <span
            class="absolute bottom-0 left-0 w-full h-0.5 bg-bao-blue-400 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center"
          ></span>
          <span
            class="absolute inset-0 bg-bao-blue-400/5 rounded-lg transform scale-0 group-hover:scale-100 transition-transform duration-300"
          ></span>
        </a>
        <a
          href="#support"
          class="nav-link group relative px-3 py-2 text-gray-600 hover:text-bao-red-300 font-medium transition-all duration-300 hover:scale-105"
        >
          <span class="relative z-10">Support</span>
          <span
            class="absolute bottom-0 left-0 w-full h-0.5 bg-bao-red-300 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center"
          ></span>
          <span
            class="absolute inset-0 bg-bao-red-300/5 rounded-lg transform scale-0 group-hover:scale-100 transition-transform duration-300"
          ></span>
        </a>
        <button
          class="btn btn-primary transform transition-all duration-300 hover:scale-105 hover:shadow-lg"
        >
          Install Now!
        </button>
      </div>

      <!-- Mobile menu button -->
      <button
        class="md:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors"
        id="mobile-menu-toggle"
      >
        <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div class="hidden md:hidden py-4 border-t border-gray-100" id="mobile-menu">
      <div class="flex flex-col space-y-4">
        <a
          href="#features"
          class="text-gray-600 hover:text-bao-blue-400 font-medium transition-colors"
        >
          Features
        </a>
        <a
          href="#how-it-works"
          class="text-gray-600 hover:text-bao-purple-300 font-medium transition-colors"
        >
          How it works
        </a>
        <a
          href="#pricing"
          class="text-gray-600 hover:text-bao-blue-400 font-medium transition-colors"
        >
          Pricing
        </a>
        <a
          href="#support"
          class="text-gray-600 hover:text-bao-red-300 font-medium transition-colors"
        >
          Support
        </a>
        <button class="btn btn-primary w-full"> Install Now! </button>
      </div>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuToggle && mobileMenu) {
    mobileMenuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Smooth scroll to sections
  document.addEventListener('DOMContentLoaded', () => {
    // Get all navigation links (both desktop and mobile)
    const navLinks = document.querySelectorAll('.nav-link, #mobile-menu a[href^="#"]');

    navLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();

        const targetId = link.getAttribute('href');
        if (!targetId || targetId === '#') return;

        const targetSection = document.querySelector(targetId) as HTMLElement;

        if (targetSection) {
          // Close mobile menu if open
          if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
            mobileMenu.classList.add('hidden');
          }

          // Get the header height to offset scroll position
          const header = document.querySelector('header') as HTMLElement;
          const headerHeight = header ? header.offsetHeight : 0;

          // Calculate the position to scroll to
          const targetPosition = targetSection.offsetTop - headerHeight;

          // Smooth scroll to the section
          window.scrollTo({
            top: targetPosition,
            behavior: 'smooth'
          });
        }
      });
    });
  });
</script>
