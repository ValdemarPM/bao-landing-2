---
// Docs Sidebar Navigation
const currentPath = Astro.url.pathname;
const baseUrl = (import.meta as any).env.BASE_URL;

const navItems = [
  {
    title: 'Getting Started',
    href: `${baseUrl}/docs`,
    icon: `${baseUrl}/icons/getting-started.svg`,
  },
  {
    title: 'Main Dashboard',
    href: `${baseUrl}/docs/dashboard`,
    icon: `${baseUrl}/icons/main-dashboard.svg`,
  },
  {
    title: 'Creating Banners',
    href: `${baseUrl}/docs/creating-banners`,
    icon: `${baseUrl}/icons/creating-banners.svg`,
  },
  {
    title: 'Slide Types',
    href: `${baseUrl}/docs/slide-types`,
    icon: `${baseUrl}/icons/slide-types.svg`,
  },
  {
    title: 'Banner Settings',
    href: `${baseUrl}/docs/settings`,
    icon: `${baseUrl}/icons/banner-settings.svg`,
  },
  {
    title: 'Banner Placement',
    href: `${baseUrl}/docs/placement`,
    icon: `${baseUrl}/icons/banner-placement.svg`,
  },
  {
    title: 'Banner Rules',
    href: `${baseUrl}/docs/rules`,
    icon: `${baseUrl}/icons/banner-rules.svg`,
  },
  {
    title: 'Advanced Features',
    href: `${baseUrl}/docs/advanced-features`,
    icon: `${baseUrl}/icons/advanced-features.svg`,
  },
  {
    title: 'AI Features',
    href: `${baseUrl}/docs/ai-features`,
    icon: `${baseUrl}/icons/ai-features.svg`,
  },
  {
    title: 'Account Management',
    href: `${baseUrl}/docs/account-management`,
    icon: `${baseUrl}/icons/account.svg`,
  },
  {
    title: 'Support & Feedback',
    href: `${baseUrl}/docs/support-feedback`,
    icon: `${baseUrl}/icons/support.svg`,
  },
];
---

<!-- Mobile Inline Accordion (only visible on mobile) -->
<div class="lg:hidden bg-white border border-gray-200 rounded-lg mb-6 overflow-hidden">
  <button
    id="docs-accordion-toggle"
    class="w-full flex items-center justify-between px-5 py-5 hover:bg-gray-50 transition-colors text-left"
    aria-label="Toggle documentation navigation"
    aria-expanded="false"
  >
    <div class="flex items-center gap-4 flex-1 min-w-0">
      <img
        id="current-page-icon-mobile"
        src={navItems.find(
          (item) =>
            currentPath === item.href ||
            currentPath === item.href + '/' ||
            (item.href.endsWith('/docs') &&
              (currentPath === item.href || currentPath === item.href + '/'))
        )?.icon || navItems[0].icon}
        alt=""
        class="w-7 h-7 flex-shrink-0 doc-icon doc-icon-active"
      />
      <div class="flex flex-col items-start min-w-0">
        <span class="text-sm text-gray-500 font-medium">Documentation</span>
        <span class="text-lg font-semibold text-gray-900 truncate">
          {
            navItems.find(
              (item) =>
                currentPath === item.href ||
                currentPath === item.href + '/' ||
                (item.href.endsWith('/docs') &&
                  (currentPath === item.href || currentPath === item.href + '/'))
            )?.title || 'Getting Started'
          }
        </span>
      </div>
    </div>
    <svg
      id="accordion-chevron"
      class="w-6 h-6 text-gray-400 transition-transform duration-200 flex-shrink-0 ml-2"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"
      ></path>
    </svg>
  </button>

  <!-- Accordion Content -->
  <div id="docs-accordion-content" class="hidden border-t border-gray-200">
    <nav class="p-4">
      <ul class="space-y-1">
        {
          navItems.map((item) => {
            const isActive =
              currentPath === item.href ||
              currentPath === item.href + '/' ||
              (item.href.endsWith('/docs') &&
                (currentPath === item.href || currentPath === item.href + '/'));
            return (
              <li>
                <a
                  href={item.href}
                  class={`flex items-center gap-4 px-4 py-3.5 rounded-lg transition-all duration-200 ${
                    isActive
                      ? 'bg-gradient-to-r from-bao-blue-50 to-bao-purple-50 text-bao-blue-500 font-semibold'
                      : 'text-gray-700 hover:bg-gray-50 hover:text-bao-blue-400'
                  }`}
                >
                  <img
                    src={item.icon}
                    alt=""
                    class={`w-7 h-7 doc-icon ${isActive ? 'doc-icon-active' : ''}`}
                  />
                  <span class="flex-1 text-lg">{item.title}</span>
                  {isActive && <span class="w-2 h-2 rounded-full bg-bao-blue-400" />}
                </a>
              </li>
            );
          })
        }
      </ul>

      <!-- Quick Links in Accordion -->
      <div class="mt-5 pt-4 border-t border-gray-200">
        <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3">
          Quick Links
        </h3>
        <ul class="space-y-2.5">
          <li>
            <a
              href={`${baseUrl}/#features`}
              class="text-lg text-gray-600 hover:text-bao-blue-400 transition-colors block"
            >
              View Features
            </a>
          </li>
          <li>
            <a
              href={`${baseUrl}/#pricing`}
              class="text-lg text-gray-600 hover:text-bao-blue-400 transition-colors block"
            >
              See Pricing
            </a>
          </li>
          <li>
            <a
              href="https://apps.shopify.com/banners-all-over"
              target="_blank"
              class="text-lg text-gray-600 hover:text-bao-red-300 transition-colors block"
            >
              Install the App ↗
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </div>
</div>

<!-- Desktop Sidebar (only visible on desktop) -->
<aside
  id="docs-sidebar"
  class="hidden lg:block sticky top-[112px] h-[calc(100vh-112px)] w-72 bg-white border-r border-gray-200 overflow-y-auto z-40"
>
  <nav class="p-6">
    <div class="mb-6">
      <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">
        Documentation
      </h2>
    </div>

    <ul class="space-y-1">
      {
        navItems.map((item) => {
          const isActive =
            currentPath === item.href ||
            currentPath === item.href + '/' ||
            (item.href.endsWith('/docs') &&
              (currentPath === item.href || currentPath === item.href + '/'));
          return (
            <li>
              <a
                href={item.href}
                class={`flex items-center gap-3 px-4 py-3 rounded-lg transition-all duration-200 group ${
                  isActive
                    ? 'bg-gradient-to-r from-bao-blue-50 to-bao-purple-50 text-bao-blue-500 font-semibold'
                    : 'text-gray-700 hover:bg-gray-50 hover:text-bao-blue-400'
                }`}
              >
                <img
                  src={item.icon}
                  alt=""
                  class={`w-5 h-5 doc-icon ${isActive ? 'doc-icon-active' : ''}`}
                />
                <span class="flex-1">{item.title}</span>
                {isActive && <span class="w-1.5 h-1.5 rounded-full bg-bao-blue-400" />}
              </a>
            </li>
          );
        })
      }
    </ul>

    <!-- Quick Links -->
    <div class="mt-8 pt-6 border-t border-gray-200">
      <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3">Quick Links</h3>
      <ul class="space-y-2">
        <li>
          <a
            href={`${baseUrl}/#features`}
            class="text-sm text-gray-600 hover:text-bao-blue-400 transition-colors"
          >
            View Features
          </a>
        </li>
        <li>
          <a
            href={`${baseUrl}/#pricing`}
            class="text-sm text-gray-600 hover:text-bao-blue-400 transition-colors"
          >
            See Pricing
          </a>
        </li>
        <li>
          <a
            href="https://apps.shopify.com/banners-all-over"
            target="_blank"
            class="text-sm text-gray-600 hover:text-bao-red-300 transition-colors"
          >
            Install the App ↗
          </a>
        </li>
      </ul>
    </div>
  </nav>
</aside>

<script>
  // Mobile accordion toggle
  const accordionToggle = document.getElementById('docs-accordion-toggle');
  const accordionContent = document.getElementById('docs-accordion-content');
  const accordionChevron = document.getElementById('accordion-chevron');

  function toggleAccordion() {
    const isHidden = accordionContent?.classList.contains('hidden');

    if (isHidden) {
      accordionContent?.classList.remove('hidden');
      accordionChevron?.classList.add('rotate-180');
      accordionToggle?.setAttribute('aria-expanded', 'true');
    } else {
      accordionContent?.classList.add('hidden');
      accordionChevron?.classList.remove('rotate-180');
      accordionToggle?.setAttribute('aria-expanded', 'false');
    }
  }

  accordionToggle?.addEventListener('click', toggleAccordion);

  // Optional: Close accordion when clicking on a link (if you want this behavior)
  const accordionLinks = accordionContent?.querySelectorAll('a');
  accordionLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      if (window.innerWidth < 1024) {
        accordionContent?.classList.add('hidden');
        accordionChevron?.classList.remove('rotate-180');
        accordionToggle?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>

<style>
  /* Custom scrollbar for sidebar */
  #docs-sidebar {
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
  }

  #docs-sidebar::-webkit-scrollbar {
    width: 6px;
  }

  #docs-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }

  #docs-sidebar::-webkit-scrollbar-thumb {
    background-color: #cbd5e1;
    border-radius: 3px;
  }

  #docs-sidebar::-webkit-scrollbar-thumb:hover {
    background-color: #94a3b8;
  }

  /* Icon color styling */
  .doc-icon {
    filter: brightness(0) saturate(100%) invert(44%) sepia(10%) saturate(419%) hue-rotate(180deg)
      brightness(95%) contrast(90%);
    transition: filter 0.2s ease;
  }

  a:hover .doc-icon {
    filter: brightness(0) saturate(100%) invert(46%) sepia(95%) saturate(1234%) hue-rotate(188deg)
      brightness(99%) contrast(101%);
  }

  .doc-icon-active {
    filter: brightness(0) saturate(100%) invert(46%) sepia(95%) saturate(1234%) hue-rotate(188deg)
      brightness(99%) contrast(101%);
  }
</style>
